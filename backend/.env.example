# Copy this file to .env and fill in real values for local development.
# Never commit the actual .env file.

DATABASE_URL=sqlite:///./taskflow.db

# Optional: set one of these to enable real LLM-based AI dependency suggestions.
# If left blank, the app falls back to a local heuristic suggester.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: set a persistent secret for JWT signing across restarts.
# If left blank, a random one is generated at startup (dev-only behavior).
SECRET_KEY=
